# Copy to .env.local and fill in. Both are optional — with neither set the site
# runs fine and PostHog simply never initialises (see src/main.tsx).

# PostHog product analytics. Project API key is a public, client-side key.
# Capturing stays opted-out until the visitor accepts cookies (POPIA).
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
